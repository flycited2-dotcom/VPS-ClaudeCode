# Telegram Bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Comma-separated list of allowed Telegram user IDs (get from @userinfobot)
ALLOWED_USER_IDS=123456789,987654321

# Working directory for Claude Code (where it will execute tasks)
WORK_DIR=/home/user/VPS-ClaudeCode

# Claude CLI path (auto-detected if empty)
CLAUDE_BIN=

# Max milliseconds to wait for Claude response (default: 5 minutes)
CLAUDE_TIMEOUT_MS=300000

# Telegram message edit interval in ms (how often to update the streaming message)
STREAM_UPDATE_INTERVAL_MS=2000
